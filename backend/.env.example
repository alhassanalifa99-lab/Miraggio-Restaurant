# Copy this file to .env and fill in real values. Never commit .env itself.

# Neon Postgres connection string (from your Neon project dashboard)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Worker dashboard password
WORKER_PASSWORD=fatawu123

# Your deployed customer site's URL — Paystack redirects the customer back
# here after payment. Use http://localhost:3000 for local dev.
FRONTEND_URL=https://miraggio-restaurant-customer.vercel.app

# Paystack — get this from your Paystack dashboard: Settings → API Keys & Webhooks
# Use the sk_test_... key while testing, sk_live_... once fully verified
PAYSTACK_SECRET_KEY=

# MTN MoMo Collections API — get these from https://momodeveloper.mtn.com
# and scripts/create-momo-sandbox-user.js (see backend/momo.js for details)
# Currently dormant/unused — kept in case MTN unblocks the account later
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
PAYSTACK_SECRET_KEY=sk_test_...
   FRONTEND_URL=https://miraggio-restaurant-customer.vercel.app
